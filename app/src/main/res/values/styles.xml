<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CeilingMeasure" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">#F2F5F8</item>
        <item name="android:colorAccent">#216E93</item>
        <item name="android:windowAnimationStyle">@style/CeilingFadeWindowAnimation</item>
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:navigationBarDividerColor">#D8E2EA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <!-- An explicit empty animation style avoids Android falling back to its
         built-in dialog animation when windowAnimations=0. The Home
         settings backdrop itself owns the single opacity transition. -->
    <style name="CeilingNoWindowAnimation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
        <item name="android:windowShowAnimation">@null</item>
        <item name="android:windowHideAnimation">@null</item>
    </style>
    <style name="CeilingFadeWindowAnimation">
        <item name="android:windowEnterAnimation">@anim/native_fade_in</item>
        <item name="android:windowExitAnimation">@anim/native_fade_out</item>
    </style>
</resources>
