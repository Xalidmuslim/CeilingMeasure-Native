PORT=8080
DATABASE_URL=postgresql://user:password@localhost:5432/ceilingmeasure
# Private key (PEM), base64-encoded to support multiline values:
LICENSE_PRIVATE_KEY_B64=
# Public key is derived at startup from the private key; embed the corresponding DER SPKI in the Android build.
OTP_PEPPER=
ADMIN_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Require TLS by default; set SMTP_SECURE=true for port 465.
SMTP_SECURE=false
